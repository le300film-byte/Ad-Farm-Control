+
+    info = ChannelInfo(channel_id=PUBLIC_CH, kind_hint=ChannelKind.PUBLIC)
+    usable = sorted(cmd for cmd in COMMAND_TIERS if env.s.guard.check(STRANGER, cmd, info).decision.allowed)
